// VERSIONINFO resource — this is what MDE reads for
// (InitiatingProcess)VersionInfoCompanyName and related fields.

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "SpectorOps"
            VALUE "FileDescription", "MDE Detection Test Binary (benign)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "detectiontest.exe"
            VALUE "OriginalFilename", "detectiontest.exe"
            VALUE "ProductName", "MDE Detection Test Binary"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
